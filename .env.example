# Correo de ventas (IMAP)
IMAP_SERVER=imap.osnentpr.com
IMAP_PORT=993
EMAIL_ACCOUNT=ventas@osnentpr.com
EMAIL_PASSWORD=

# Bandeja a vigilar. En muchos servidores es INBOX.
MAILBOX=INBOX

# Palabra a buscar en el asunto (sin distinguir mayúsculas)
SUBJECT_KEYWORD=contrato

# Si es true, deja el correo como no leído (recomendado mientras se prueba).
PEEK_ONLY=true
