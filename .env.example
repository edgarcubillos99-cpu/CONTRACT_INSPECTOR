# App de Azure (Microsoft Entra ID)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Buzón que debe leer el bot (cuenta de ventas)
EMAIL_ACCOUNT=ventas@osnetpr.com

# Bandeja de Graph. Lo normal es inbox.
MAILBOX=inbox

# Palabra a buscar en el asunto (sin distinguir mayúsculas)
SUBJECT_KEYWORD=contrato

# Ubersmith (HTTP Basic Auth: usuario y contraseña)
UBERSMITH_URL=https://billing.gofiberx.com/api/2.0/
UBERSMITH_USER=
UBERSMITH_PASSWORD=

# Servicio (el contenedor escucha en 8080; PORT es el puerto en el host)
PORT=8080
POLL_INTERVAL=60

# false mientras no exista Mail.ReadWrite. Los IDs se recuerdan en data/processed_ids.txt
MARK_AS_READ=false

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
